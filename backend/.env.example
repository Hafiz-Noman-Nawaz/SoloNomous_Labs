# =========================================================================
# SoloNomous Labs Backend Environment Configuration
# Add these environment variables in your Vercel Project Settings -> Environment Variables
# =========================================================================

# Node Environment
NODE_ENV=production
PORT=5000

# MongoDB Database Connection String (MongoDB Atlas recommended for Vercel)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/solonomous_labs?retryWrites=true&w=majority

# JWT Security Secrets (Use long random strings)
JWT_SECRET=solonomous_production_jwt_secret_super_secure_key_2026_xyz
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CORS_ORIGIN=https://solonomous-labs.vercel.app
NEXT_PUBLIC_APP_URL=https://solonomous-labs.vercel.app

# Google Gemini API Key (For AI Assistant & RAG embeddings)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary (Media assets & portfolio storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Clerk Authentication Backend Keys
CLERK_SECRET_KEY=sk_live_xxxx
CLERK_PUBLISHABLE_KEY=pk_live_xxxx
